# --- Required ---
# Tractive account (email + password login; Google/Apple-only accounts do not work)
TRACTIVE_EMAIL=
TRACTIVE_PASSWORD=
# Password of this web app; the server refuses to start without it (8+ characters). Changing it logs everyone out.
APP_PASSWORD=

# --- Tracker ---
# Which tracker to follow (8 characters, e.g. ABCD1234). Empty: the first tracker with an active subscription.
TRACTIVE_TRACKER_ID=

# --- Telegram (optional; empty token = bot off) ---
TELEGRAM_BOT_TOKEN=
# Shown in the UI until the bot answers getMe
TELEGRAM_BOT_NAME=
# Comma-separated chat ids approved at start (pairing from the web app also works)
TELEGRAM_CHAT_IDS=
# seconds between checks of a pinned Telegram panel (5-3600); it is edited only when something changed
TELEGRAM_PANEL_REFRESH_S=20
# Public URL of this app; used for links in Telegram messages
APP_URL=

# --- Web server ---
# Host address and port published by docker compose (default 127.0.0.1:8090)
OT_BIND=127.0.0.1
OT_PORT=8090
# Set to 1 only behind a reverse proxy (trusts X-Forwarded-For/-Proto/-Host)
TRUST_PROXY=
# IANA time zone, e.g. Europe/Madrid; default UTC
TZ=

# --- Advanced (defaults are the production values) ---
# Minimum milliseconds between Tractive REST requests (8000 if you ever see rate limits)
TRACTIVE_MIN_GAP_MS=5000
TRACTIVE_CLIENT_ID=625e533dc3c3b41c28a669f0
TRACTIVE_GRAPH_URL=https://graph.tractive.com/4
TRACTIVE_CHANNEL_URL=https://channel.tractive.com/3/channel
TRACTIVE_APS_URL=https://aps-api.tractive.com/api/1
TRACTIVE_TIMELINE_URL=https://prod.eu-central-1.event-timeline-api.tractive.com/api/1
TELEGRAM_API_URL=https://api.telegram.org
# Directory of the SQLite database (the docker image uses /app/data)
DATA_DIR=
# Listen address and port inside the process (docker image: 0.0.0.0:8080; use OT_BIND/OT_PORT with compose)
HOST=
PORT=
# Delay between requests of scripts/probe.mjs in milliseconds (default 8000)
PROBE_DELAY_MS=
