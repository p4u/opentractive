{
  "name": "opentractive",
  "version": "0.1.0",
  "description": "Self-hosted monitor for Tractive pet GPS trackers: live map, escape alarms, hole finder in the fence, Telegram bot",
  "repository": { "type": "git", "url": "https://github.com/p4u/opentractive" },
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\"",
    "mock": "node test/mock/server.js",
    "check-fixtures": "node scripts/check-fixtures.mjs"
  },
  "dependencies": {
    "@fontsource-variable/eb-garamond": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@geoman-io/leaflet-geoman-free": "2.20.8",
    "apexcharts": "8.9.1",
    "leaflet": "1.9.4",
    "lucide-static": "1.75.0"
  },
  "devDependencies": { "@playwright/test": "1.65.1" }
}
